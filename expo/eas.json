{
  "cli": {
    "version": ">= 5.9.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "distribution": "store",
      "ios": {
        "enterpriseProvisioning": "adhoc"
      },
      "credentialsSource": "remote"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "REPLACE_AFTER_CREATING_APP_RECORD",
        "appleId": "REPLACE_WITH_YOUR_APPLE_ID_EMAIL"
      }
    }
  }
}
